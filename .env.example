# Copy this file to `.env` for local development, and set the same keys in
# your hosting platform's environment variables for production (Render,
# Railway, etc.). Never commit the real .env file.

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://your-frontend-domain.com

# ── Brevo (transactional email) ─────────────────────────────────────────
# API key from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=
# Must be a sender email verified in Brevo → Senders, Domains & Dedicated IPs.
# If this address is NOT verified in Brevo, sends will fail silently (the
# app logs "❌ ... Email Error" server-side but the request that triggered
# it still succeeds, so it can look like "nothing happened").
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="Mublat Bake & Blends"

# Where new-order notifications and support form submissions are sent.
ADMIN_EMAIL=mublatbakeandblends@gmail.com

# ── Cloudinary (product image uploads) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe (card payments, if enabled) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── One-off admin seed script (server/seedAdmin.js) ─────────────────────
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=
